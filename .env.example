# Scaledger — environment configuration
# Every value below is read server-side only. None of these are ever sent to the frontend
# bundle or returned in any API response — see SECURITY.md Section 1.

# --- Solana RPC (read by: RebaseDetectionService, and System 1's /api/holdings handler) ---
# Public mainnet RPC works for development but is rate-limited (see SECURITY.md Section 3).
# For the judge demo, use a provider key (Helius/QuickNode/etc.) to avoid live rate-limit risk.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# The STRCx mint address — the demo ticker's Token-2022 mint on Solana.
# Read by: RebaseDetectionService (Step 3), System 1's allowlist filter (Step 2).
DEMO_TICKER_MINT=Xs78JED6PFZxWc2wCEPspZW9kL3Se5J7L5TChKgsidH

# How far back RebaseDetectionService scans the mint's transaction history via
# getSignaturesForAddress, in days. See SECURITY.md Section 3 for why this is bounded.
# Read by: RebaseDetectionService.
RPC_SCAN_LOOKBACK_DAYS=400

# --- xStocks public API (read by: CorporateActionReferenceService, Step 4) ---
# Per DECISIONS.md D4, public endpoints are documented as requiring no key — this is only
# needed if the Day-1 implementation spike finds an authenticated endpoint is required for
# the specific corporate-action/multiplier data this product needs.
XSTOCKS_API_BASE_URL=https://api.xstocks.fi
XSTOCKS_API_KEY=

# --- Backpack Securities mint/redeem API (stretch-only — Step 7, DECISIONS.md D6) ---
# Only needed if a Backpack-issued ticker is brought into scope after Step 9. ED25519
# keypair auth per Backpack's docs — the private key signs each request; it must never be
# logged, returned in a response, or included in an exported record.
# Read by: IssuerDisclosureService (Backpack branch only).
BACKPACK_API_BASE_URL=https://api.backpack.exchange
BACKPACK_API_PUBLIC_KEY=
BACKPACK_API_PRIVATE_KEY=

# --- Database (read by: the backend process at startup) ---
# SQLite via Node's built-in `node:sqlite` module — a single file, zero external service
# to run during the demo. Must actually persist across process restarts for Step 9's
# ledger view to hold up (PRD.md Step 9 Definition of Done requires surviving a page
# reload, which requires the DB to survive it too) — a file path satisfies this; ":memory:"
# would not and must never be used outside of unit tests.
DATABASE_URL=./data/scaledger.db

# --- Verification tolerance (read by: computeStatus, Step 1's CONTRACT.md) ---
# Percentage-point tolerance below which expected_ratio and actual_ratio are treated as
# matching. Documented as a named constant per PRD.md Section 1 — not a magic number
# buried in code. Changing this does not reinterpret historical VerificationRecords rows,
# since each row stores its own tolerance_used at computation time.
VERIFICATION_TOLERANCE_PP=0.01

# --- App mode (read by: the frontend "Run Demo" button and backend DataSource selection) ---
# 'live' uses SolanaRpcSource + real xStocks/manual fetches.
# 'demo' uses FixtureSource (ARCHITECTURE.md Section 6) — same compute code, frozen data.
# Never set at the infra level for the actual judge demo without the on-screen disclosure
# label also being shown (PRD.md Step 10 non-negotiable invariant).
APP_MODE=live
